# GEMINI_API_KEY: Required for server-side Pip AI (Google Gemini) calls.
# AI Studio injects this automatically at runtime from Settings > Secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Public URL where PancakePilot AI is hosted (used for magic links).
APP_URL="http://localhost:3000"

# RESEND_API_KEY: Optional. Required for sending real magic-link verification emails in production.
# When omitted, PancakePilot AI uses a truthful development preview link and preserves Guest/Demo modes.
RESEND_API_KEY="YOUR_RESEND_API_KEY"

# AUTH_FROM_EMAIL: Verified sender address for Resend magic links.
AUTH_FROM_EMAIL="PancakePilot AI <auth@yourdomain.com>"

# SESSION_SECRET: Secret key used to sign authentication session tokens.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"
